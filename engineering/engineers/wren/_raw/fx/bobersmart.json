age","color_info":{"palette":[{"percentage":97.77,"rgb":{"blue":9,"green":2,"red":5}},{"percentage":1.21,"rgb":{"blue":131,"green":129,"red":130}},{"percentage":0.45,"rgb":{"blue":148,"green":130,"red":201}},{"percentage":0.29,"rgb":{"blue":31,"green":40,"red":66}},{"percentage":0.1,"rgb":{"blue":106,"green":47,"red":67}}]},"original_img_height":681,"original_img_url":"https://pbs.twimg.com/media/HTFq85wWkAAO608.jpg","original_img_width":1280},"media_key":"3_2103580095487053824"},{"id":"QXBpTWVkaWE6DAAFCgABHTFo9JwXkAAKAAIbkB7cExrwAAAA","media_id":"2103577900758831104","media_info":{"__typename":"ApiImage","color_info":{"palette":[{"percentage":46.94,"rgb":{"blue":42,"green":20,"red":13}},{"percentage":37.63,"rgb":{"blue":72,"green":87,"red":94}},{"percentage":5.85,"rgb":{"blue":106,"green":51,"red":212}},{"percentage":2.24,"rgb":{"blue":64,"green":33,"red":107}},{"percentage":1.33,"rgb":{"blue":53,"green":149,"red":194}}]},"original_img_height":720,"original_img_url":"https://pbs.twimg.com/media/HTFo9JwXkAAmVDi.jpg","original_img_width":1280},"media_key":"3_2103577900758831104"}]},"twitter_card":"tweet","color":null,"provider":"twitter","reposted_by":null}}