// Zed — merge into your Zed settings.json (~/.config/zed/settings.json,
// or open it with `zed: open settings` from the command palette).
// Zed settings are JSONC, so these comments are fine.
// Replace /absolute/path/to/jev-playwright-mcp with your checkout path.
// "--headless" is an upstream Playwright MCP flag and is optional.
{
  "context": {
    "servers": {
      "jev-playwright": {
        "source": "custom",
        "command": "node",
        "args": [
          "/absolute/path/to/jev-playwright-mcp/cli.js",
          "--jev-mode=all",
          "--headless"
        ],
        "env": {
          "TYPESAFE_API_KEY": "tsk_YOUR_KEY_HERE"
        }
      }
    }
  }
}
