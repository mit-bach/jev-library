# --- Mode ------------------------------------------------------------------
# llm-direct (default): the LLM sees all 100 tools and picks. jev-classifier: Jev picks.
AGENT_MODE=llm-direct

# --- Model (both modes) ----------------------------------------------------
# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Model served through OpenRouter (default below)
OPENROUTER_MODEL=google/gemini-3.8-flash
# Reasoning effort per mode. Gemini 3.8 Flash on OpenRouter only accepts low|medium|high
# (reasoning is mandatory and cannot be disabled).
DIRECT_REASONING=medium
JEV_REASONING=low
# Upstream pinned on OpenRouter (google-ai-studio | google-vertex); see agent.ts
OPENROUTER_UPSTREAM=google-ai-studio
# Max output tokens per model call (keeps OpenRouter from reserving the model max against your credit)
OPENROUTER_MAX_TOKENS=8192

# --- Classifier (AGENT_MODE=jev-classifier only) --------------------------
# TypeSafe key: https://typesafe.ai
TYPESAFE_API_KEY=ts-...
# Optional: TYPESAFE_DEFAULT_MODEL=jev-latest

# --- Local smoke test without any API key ---------------------------------
# AGENT_MODEL=mock   -> uses eve's mockModel with a scripted tool plan; add JEV_STUB=1 for jev-classifier

# --- Misc ------------------------------------------------------------------
EVE_TELEMETRY_DISABLED=1
# EVAL_RESULTS_DIR=./eval-results
