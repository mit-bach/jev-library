{
  "name": "wrong-password",
  "steps": [
    { "goto": "/auth/login" },
    { "fill": "#email", "value": "${QA_EMAIL}" },
    { "press": "#email", "key": "Enter" },
    { "waitForSelector": "#password" },
    { "fill": "#password", "value": "definitely-wrong-password" },
    { "press": "#password", "key": "Enter" },
    { "wait": 2000 },
    { "expect": "The login form is still displayed and an error explains the credentials were rejected." }
  ]
}
