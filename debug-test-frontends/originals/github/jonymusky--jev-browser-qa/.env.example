# Vercel AI Gateway key. Jev is billed through the gateway as typesafe-ai/jev.
AI_GATEWAY_API_KEY=

# Application under test.
BASE_URL=http://localhost:3000
QA_EMAIL=
QA_PASSWORD=

# Jev tuning (optional).
# Minimum probability for an expect()/judge() claim to pass.
JEV_JUDGE_THRESHOLD=0.7
# Minimum probability for an action chosen by pick()/runGoal() to be executed.
JEV_ACTION_MIN_CONFIDENCE=0.55
# Ask the gateway for zero-data-retention routing.
JEV_ZERO_DATA_RETENTION=true
